---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import type { projects } from '../data/projects';
interface Props {
  project: (typeof projects)[number];
  variant?: 'standard' | 'featured' | 'compact';
}
const { project, variant = 'standard' } = Astro.props;
const featured = variant === 'featured';
const imageSizes = featured
  ? '(max-width: 799px) 100vw, 55vw'
  : '(max-width: 799px) 100vw, 44vw';
---

<article class:list={['project-card', `project-card-${variant}`]}>
  <a
    href={`/projekty/${project.slug}/`}
    class="project-image-link"
    data-project-visual={project.slug}
    aria-label={`Zobacz koncepcję: ${project.title}`}
  >
    <span class="project-photo">
      <Image
        src={project.image}
        alt={project.alt}
        widths={featured ? [480, 800, 1200, 1536] : [400, 640, 1000]}
        sizes={imageSizes}
        format="webp"
        loading="lazy"
      />
    </span>
    <span class="image-note">Koncepcja demonstracyjna</span>
    <span class="image-arrow">
      <Icon name="diagonal" />
    </span>
  </a>
  <div class="project-meta">
    <span>
      {project.number} / {project.category}
    </span>
    <h3>
      <a href={`/projekty/${project.slug}/`}>{project.title}</a>
    </h3>
    <p>{project.subtitle}</p>
    {featured && <p class="project-card-description">{project.intro}</p>}
  </div>
</article>
