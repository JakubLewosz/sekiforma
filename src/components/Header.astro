---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
const pathname = Astro.url.pathname;
const links = [
  ['/oferta', 'Oferta'],
  ['/projekty', 'Koncepcje'],
  ['/pracownia', 'Pracownia'],
];
---

<header class="site-header">
  <div class="container header-inner">
    <Logo />
    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="main-nav"
    >
      <span>Menu</span>
      <span class="menu-lines" aria-hidden="true"></span>
    </button>
    <nav id="main-nav" class="main-nav" aria-label="Nawigacja główna">
      {links.map(([href, label]) => (
        <a
          href={href}
          aria-current={pathname.startsWith(href) ? 'page' : undefined}
        >
          {label}
        </a>
      ))}
      <a
        class="nav-cta"
        href="/kontakt"
        aria-current={pathname.startsWith('/kontakt') ? 'page' : undefined}
      >
        Porozmawiajmy <Icon name="diagonal" />
      </a>
    </nav>
  </div>
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.querySelector<HTMLElement>('#main-nav');
  const mobile = window.matchMedia('(max-width: 799px)');
  function closeMenu() {
    toggle?.setAttribute('aria-expanded', 'false');
    nav?.classList.remove('is-open');
    if (nav) nav.inert = mobile.matches;
  }
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(open));
    nav?.classList.toggle('is-open', open);
    if (nav) nav.inert = !open && mobile.matches;
  });
  document.addEventListener('keydown', (e) => {
    if (
      e.key === 'Escape' &&
      toggle?.getAttribute('aria-expanded') === 'true'
    ) {
      closeMenu();
      toggle.focus();
    }
  });
  document.addEventListener('click', (e) => {
    if (
      e.target instanceof Node &&
      !document.querySelector('.header-inner')?.contains(e.target)
    )
      closeMenu();
  });
  mobile.addEventListener('change', closeMenu);
  nav?.addEventListener('click', (event) => {
    if (event.target instanceof Element && event.target.closest('a'))
      closeMenu();
  });
  window.addEventListener('pageshow', closeMenu);
  closeMenu();
</script>
