---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
interface Props {
  items: { image: ImageMetadata; alt: string; caption: string }[];
}
const { items } = Astro.props;
const pictures = await Promise.all(
  items.map(async (item) => ({
    ...item,
    full: (
      await getImage({
        src: item.image,
        width: item.image.width,
        format: 'webp',
      })
    ).src,
  })),
);
---

<div class:list={['gallery', { 'gallery-expanded': pictures.length > 2 }]}>
  {pictures.map((item, index) => (
    <figure>
      <button
        type="button"
        class="gallery-trigger"
        data-full={item.full}
        data-alt={item.alt}
        data-caption={item.caption}
        aria-label={`Powiększ: ${item.caption}`}
        aria-haspopup="dialog"
      >
        <Image
          src={item.image}
          alt={item.alt}
          widths={[480, 800, 1200]}
          sizes="(max-width:799px) 100vw, 55vw"
          loading="lazy"
        />
        <span class="gallery-hint">Powiększ ↗</span>
      </button>
      <figcaption>
        0{index + 1} / {item.caption}
      </figcaption>
    </figure>
  ))}
</div>
<dialog class="lightbox" aria-label="Galeria wizualizacji">
  <button type="button" class="lightbox-close">
    Zamknij <Icon name="close" />
  </button>
  <img class="lightbox-image" alt="" />
  <p class="lightbox-caption" aria-live="polite"></p>
  <div class="lightbox-nav">
    <button type="button" class="lightbox-prev" aria-label="Poprzednie zdjęcie">
      ←
    </button>
    <span class="lightbox-count"></span>
    <button type="button" class="lightbox-next" aria-label="Następne zdjęcie">
      →
    </button>
  </div>
</dialog>
<script>
  const triggers = Array.from(
    document.querySelectorAll<HTMLButtonElement>('.gallery-trigger'),
  );
  const dialog = document.querySelector<HTMLDialogElement>('.lightbox');
  const image = dialog?.querySelector<HTMLImageElement>('.lightbox-image');
  const preference = window.matchMedia('(prefers-reduced-motion: reduce)');
  let active = 0;
  let request = 0;
  let closing = false;
  let opener: HTMLButtonElement | undefined;
  let imageAnimation: Animation | undefined;
  let closingAnimation: Animation | undefined;

  function display(index: number) {
    active = (index + triggers.length) % triggers.length;
    const button = triggers[active];
    const token = ++request;
    const caption = dialog?.querySelector('.lightbox-caption');
    const counter = dialog?.querySelector('.lightbox-count');
    const thumbnail = button.querySelector('img')?.currentSrc;
    if (image && !dialog?.open) {
      image.alt = button.dataset.alt ?? '';
      if (thumbnail) image.src = thumbnail;
      else image.removeAttribute('src');
    }
    if (caption && !dialog?.open)
      caption.textContent = button.dataset.caption ?? '';
    if (counter) counter.textContent = `${active + 1} / ${triggers.length}`;
    dialog?.setAttribute('aria-busy', 'true');
    const fullImage = new Image();
    fullImage.src = button.dataset.full ?? '';
    const show = () => {
      if (token !== request || !image) return;
      imageAnimation?.cancel();
      image.src = fullImage.src;
      image.alt = button.dataset.alt ?? '';
      if (caption) caption.textContent = button.dataset.caption ?? '';
      dialog?.setAttribute('aria-busy', 'false');
      if (!preference.matches && dialog?.open) {
        imageAnimation = image.animate([{ opacity: 0.35 }, { opacity: 1 }], {
          duration: 220,
          easing: 'ease-out',
        });
      }
    };
    fullImage.decode().then(show, show);
  }

  function close() {
    if (!dialog?.open || closing) return;
    closing = true;
    ++request;
    imageAnimation?.cancel();
    const finish = () => {
      dialog.close();
      closing = false;
    };
    if (preference.matches) {
      finish();
      return;
    }
    closingAnimation = dialog.animate(
      [
        { opacity: 1, transform: 'none' },
        { opacity: 0, transform: 'translateY(8px)' },
      ],
      {
        duration: 160,
        easing: 'ease-in',
      },
    );
    closingAnimation.finished.then(finish, finish);
  }

  triggers.forEach((button, index) =>
    button.addEventListener('click', () => {
      opener = button;
      closing = false;
      display(index);
      dialog?.showModal();
      document.body.style.overflow = 'hidden';
    }),
  );
  dialog?.querySelector('.lightbox-close')?.addEventListener('click', close);
  dialog
    ?.querySelector('.lightbox-prev')
    ?.addEventListener('click', () => display(active - 1));
  dialog
    ?.querySelector('.lightbox-next')
    ?.addEventListener('click', () => display(active + 1));
  dialog?.addEventListener('cancel', (event) => {
    event.preventDefault();
    close();
  });
  dialog?.addEventListener('close', () => {
    ++request;
    document.body.style.overflow = '';
    dialog.removeAttribute('aria-busy');
    opener?.focus();
  });
  dialog?.addEventListener('click', (event) => {
    if (event.target !== dialog) return;
    const bounds = dialog.getBoundingClientRect();
    if (
      event.clientX < bounds.left ||
      event.clientX > bounds.right ||
      event.clientY < bounds.top ||
      event.clientY > bounds.bottom
    )
      close();
  });
  dialog?.addEventListener('keydown', (event) => {
    if (closing) return;
    if (event.key === 'ArrowRight') {
      display(active + 1);
      event.preventDefault();
    }
    if (event.key === 'ArrowLeft') {
      display(active - 1);
      event.preventDefault();
    }
    if (event.key !== 'Tab') return;
    const controls = Array.from(
      dialog.querySelectorAll<HTMLButtonElement>('button'),
    );
    const current = controls.findIndex(
      (control) => control === document.activeElement,
    );
    const next =
      (current + (event.shiftKey ? -1 : 1) + controls.length) % controls.length;
    // Keep every Tab within the dialog, including macOS WebKit's default
    // keyboard mode, which otherwise skips buttons and focuses the page.
    event.preventDefault();
    controls[next]?.focus();
  });
  preference.addEventListener('change', () => {
    if (preference.matches) {
      imageAnimation?.cancel();
      closingAnimation?.cancel();
    }
  });
</script>
