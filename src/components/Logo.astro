---
const { footer = false } = Astro.props;
---

<a
  class:list={['logo', { 'logo-footer': footer }]}
  href="/"
  aria-label="Sęk i Forma — strona główna"
>
  <svg
    class="brand-mark"
    width="40"
    height="40"
    viewBox="0 0 44 44"
    fill="none"
    stroke="currentColor"
    stroke-width="1.1"
    aria-hidden="true"
  >
    <path d="M22 3C11 2 3 12 4 23s8 18 19 18 18-9 17-20S32 4 22 3Z" />
    <path d="M22 10c-7-1-12 6-12 13s6 12 13 12 11-6 11-13-6-12-12-12Z" />
    <path d="M22 17c-3 0-6 2-6 6s3 6 7 6 6-3 5-7-3-5-6-5Z" />
  </svg>
  <span>
    Sęk i Forma<small>PRZESTRZEŃ PO TWOJEMU</small>
  </span>
</a>
